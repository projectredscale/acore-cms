# WordPress environment.
#
# Mounted as env_file by the php service. The plugin's ten options (database hosts,
# SOAP endpoint, credentials) are not here: they are set through WP-CLI by
# a WP-CLI pass, because they live in the WordPress database rather
# than in the process environment.

DOCKER_ENVIRONMENT=production
WP_ENVIRONMENT_TYPE=production

# acore-cms's init.sh reads the WORDPRESS_* names, not the DOCKER_* ones: upstream's
# own compose file maps them, and this stack sets them here instead so the mapping
# lives next to the values. With WORDPRESS_MULTISITE unset, init.sh's test
# `[ $WORDPRESS_MULTISITE = "false" ]` fails and its ERR trap kills the container
# before the CMS is ever installed.
WORDPRESS_MULTISITE=false
WORDPRESS_MULTISITE_USE_SUBDOMAIN=
WORDPRESS_TITLE=Redscale
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD={{secret:CMS_WP_ADMIN_PASSWORD}}
WORDPRESS_ADMIN_EMAIL=admin@CHANGE_ME_MAIL_DOMAIN

# Behind Cloudflare the site is HTTPS even though nginx speaks plain HTTP, so
# WORDPRESS_URL is the public hostname. init.sh passes it to `wp core install`, and
# the same WP-CLI pass sets siteurl and home from the same value afterwards.
WORDPRESS_URL=https://CHANGE_ME_SHOP_HOSTNAME
WORDPRESS_DB_HOST=wp-db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress

# init.sh runs setfacl against these, so they have to match the image's uid and gid.
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Acore WP plugin options are written by that WP-CLI pass, not here.
ACORE_CMS_CONFIGURE_ON_BOOT=false

TZ=UTC
