# Compose interpolation for the CMS stack, one file per installation.
#
# Copy to compose.env beside this file and fill in. The WordPress credentials are secrets:
# they belong in the secrets file this product resolves its tokens from, not here.
REGISTRY=ghcr.io/projectredscale
# `TAG_CMS` is the one tag no realm release moves: the CMS image is loaded on the host
# separately, so this key names the image that is actually there.
TAG_CMS=prod

# The mesh VPN address `cms-web` publishes its port on.
MESH_BIND_IP=CHANGE_ME_MESH_BIND_IP
# The mail host, as the CMS container has to reach it: the mail name resolves to the public
# address, where its client ports are closed, so the name is pointed at the mesh address inside
# that container.
MAIL_DOMAIN=CHANGE_ME_MAIL_DOMAIN
TZ=UTC

WORDPRESS_DB_ROOT_PASSWORD={{secret:WORDPRESS_DB_ROOT_PASSWORD}}
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD={{secret:WORDPRESS_DB_PASSWORD}}
